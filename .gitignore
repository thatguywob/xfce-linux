env/

# Git hooks (local)
.git/hooks/*.local

# Temporary junction checkouts (BuildStream)
.bst/staged-junctions/

# Node modules (if used in any scripts)
node_modules/

# Local VM/debug outputs kept at repo root during manual bring-up
/$LOG
/session.txt
/*.png
/*.ppm

# ISO build staging artifacts
output/
*-cs-staging/
*-sfs-root/

# ── Large generated / vendored artifacts (repo-hygiene: #15, #16, #17) ──
# Vendored dependency headers — build-time only, should not be committed
xfwl4-headers/
# Pre-built XFCE binaries — fetched by elements/xfce-linux/xfce-binaries.bst
# via a pinned tarball (#16); keep out of git
files/xfce-binaries/
# Chunkah file map — generated by scripts/gen-filemap.py at build time (#17)
files/filemap.json
# Fakecap privilege manifest — generated alongside filemap.json (#17)
files/fakecap-manifest.tsv

# Python coverage reports
.coverage
coverage.xml
htmlcov/
